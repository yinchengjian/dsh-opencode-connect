{
  "name": "dsh-opencode-connect",
  "displayName": "DSH OpenCode Connect",
  "description": "把 OpenCode 免费模型接入 DeepSeek Harness — bring OpenCode free models into DeepSeek Harness with zero credentials.",
  "version": "0.1.2",
  "author": "yinchengjian",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "free-models",
    "llm-adapter",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinchengjian/dsh-opencode-connect.git"
  },
  "homepage": "https://github.com/yinchengjian/dsh-opencode-connect#readme",
  "bugs": {
    "url": "https://github.com/yinchengjian/dsh-opencode-connect/issues"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@earendil-works/pi-ai": "^0.87.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
